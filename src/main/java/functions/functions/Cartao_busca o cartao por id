CREATE OR REPLACE FUNCTION public.cartao_por_id_v1(
	p_id bigint)
RETURNS TABLE(
	tipo_cartao character varying,
	id_cartao bigint,
	ativo_ou_nao boolean,
	cvv bigint,
	numero bigint,
	senha bigint,
	fatura double precision,
	limite_diario double precision,
	limite_credito double precision,
	id_conta bigint
)
LANGUAGE 'plpgsql'
COST 100
VOLATILE PARALLEL UNSAFE
ROWS 1000
AS $BODY$
BEGIN
	RETURN QUERY
	SELECT 
		c.tipo_cartao,
		c.id AS id_cartao,
		c.ativo_ou_nao,
		c.cvv,
		c.numero,
		c.senha,
		c.fatura,
		c.limite_diario,
		CASE 
			WHEN c.tipo_cartao = 'CartaoDeCredito' THEN c.limite_credito 
			ELSE NULL 
		END AS limite_credito,
		c.id_conta
	FROM cartao c
	WHERE c.id = p_id;
END;
$BODY$;

ALTER FUNCTION public.cartao_por_id_v1(bigint)
OWNER TO postgres;


