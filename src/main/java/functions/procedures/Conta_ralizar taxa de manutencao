-- PROCEDURE: public.conta_aplicar_taxa_manutencao_v1(bigint)

-- DROP PROCEDURE IF EXISTS public.conta_aplicar_taxa_manutencao_v1(bigint);

CREATE OR REPLACE PROCEDURE public.conta_aplicar_taxa_manutencao_v1(
	IN p_id_conta bigint)
LANGUAGE 'plpgsql'
AS $BODY$
DECLARE
	v_tipo_conta smallint;
	v_tipo_cliente smallint;
	v_id_cliente bigint;
	v_taxa_manutencao double precision;
BEGIN

SELECT conta.tipo_conta, conta.id_cliente, cliente.tipo
    INTO v_tipo_conta, v_id_cliente, v_tipo_cliente
    FROM conta
    JOIN cliente ON cliente.id = conta.id_cliente
    WHERE conta.id = p_id_conta;

IF v_tipo_conta != 1 THEN
	RAISE EXCEPTION 'Conta informada não é uma conta corrente';
END IF;

IF v_tipo_cliente = 0 THEN
	v_taxa_manutencao := 12;
ELSEIF v_tipo_cliente = 1 THEN
	v_taxa_manutencao := 8;
ELSE
	v_taxa_manutencao := 0;
END IF;

UPDATE conta set saldo = saldo - v_taxa_manutencao WHERE id = p_id_conta;

END;
$BODY$;
ALTER PROCEDURE public.conta_aplicar_taxa_manutencao_v1(bigint)
    OWNER TO postgres;
