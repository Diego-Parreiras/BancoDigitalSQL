-- PROCEDURE: public.conta_save_v1(bigint, character varying, bigint, double precision, bigint, integer, bigint)

-- DROP PROCEDURE IF EXISTS public.conta_save_v1(bigint, character varying, bigint, double precision, bigint, integer, bigint);

CREATE OR REPLACE PROCEDURE public.conta_save_v1(
	IN p_agencia bigint,
	IN p_chave_pix character varying,
	IN p_numero bigint,
	IN p_saldo double precision,
	IN p_senha bigint,
	IN p_tipo_conta integer,
	IN p_id_cliente bigint)
LANGUAGE 'plpgsql'
AS $BODY$
BEGIN

	INSERT INTO conta(
	agencia,
	chave_pix,
	numero,
	saldo,
	senha,
	tipo_conta,
	id_cliente
	)VALUES(
	p_agencia,
	p_chave_pix,
	p_numero,
	p_saldo,
	p_senha,
	p_tipo_conta,
	p_id_cliente);

END;
$BODY$;
ALTER PROCEDURE public.conta_save_v1(bigint, character varying, bigint, double precision, bigint, integer, bigint)
    OWNER TO postgres;
